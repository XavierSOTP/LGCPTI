<UserControl
  x:Class="LGC.PTI.Plugin.Client.ConfigPages.Plugin.General.ConfigPageView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:general="clr-namespace:LGC.PTI.Plugin.Client.ConfigPages.Plugin.General"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:styleExt="clr-namespace:Genetec.Sdk.Controls.Themes.Styles;assembly=Genetec.Sdk.Controls"
  xmlns:system="clr-namespace:System;assembly=mscorlib"
  d:DataContext="{d:DesignInstance general:ConfigPage}"
  d:DesignHeight="700"
  d:DesignWidth="500"
  mc:Ignorable="d">

    <UserControl.Resources>
        <system:Boolean x:Key="True">True</system:Boolean>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Top">

            <TextBlock Margin="0,10,0,15" Foreground="White">
 <Run Text="Fields marked with " />
 <Run Text="*" Foreground="Red" FontWeight="Bold" />
 <Run Text=" are mandatory." />
            </TextBlock>

            <!--<GroupBox Header="Security Center SDK Credentials" 
            Foreground="#2973B7"
            FontWeight="Bold" 
            Margin="0,0,0,10" 
            BorderBrush="#444"
            BorderThickness="0.5">
                <StackPanel Orientation="Vertical" Margin="10">
                    <TextBlock Text="User *" Margin="0,10,0,0" Foreground="White" />
                    <TextBox Text="{Binding SCLoginUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Password *" Foreground="White" VerticalAlignment="Center"/>
                    <PasswordBox PasswordChanged="OnPasswordChanged"/>
                </StackPanel>
            </GroupBox>-->

            <GroupBox Header="Iq Tech portal API Configuration"
          Foreground="#2973B7"
          FontWeight="Bold"
          Margin="0,0,0,10"
          BorderBrush="#444"
          BorderThickness="0.5">

                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="103*"/>
                        <ColumnDefinition Width="328*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="Service Settings"
                  Margin="0,0,0,10"
                 Foreground="#3A86C8"
                  BorderBrush="#666"
                  BorderThickness="0.5" Grid.ColumnSpan="2">

                        <StackPanel Margin="10">
                            <TextBlock Text="Employee URL *"
                           Margin="0,10,0,0"
                           Foreground="White"/>

                            <TextBox Text="{Binding EmployeeUrl,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Security"
          Grid.Row="1"
          Foreground="#3A86C8"
          BorderBrush="#666"
          BorderThickness="0.5" Grid.ColumnSpan="2">

                        <StackPanel Margin="10">

                            <TextBlock Text="Token Url *" Margin="0,10,0,0" Foreground="White"/>
                            <TextBox Text="{Binding TokenURL, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Client Id *" Foreground="White"/>
                            <PasswordBox PasswordChanged="LGCClientIdChange"/>

                            <TextBlock Text="Client Secret *" Foreground="White"/>
                            <PasswordBox PasswordChanged="LGCClientSecretChange"/>


                            <Button Content="Test Connection"
                Command="{Binding TestConnectionCommand}"
                IsEnabled="{Binding IsNotTesting}"
                HorizontalAlignment="Left"
                Padding="12,6"
                Margin="0,12,0,0"
                Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#2973B7"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1a5fa3"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Background" Value="#555"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <TextBlock Text="⏳ Testing connection..."
                   Foreground="#aaa"
                   FontStyle="Italic"
                   Margin="0,8,0,0"
                   Visibility="{Binding IsTesting,
                       Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <Border CornerRadius="4"
                Padding="10,7"
                Margin="0,8,0,0"
                Background="{Binding TestStatusBackground}"
                Visibility="{Binding TestStatusVisibility}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TestStatusIcon}"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding TestStatusMessage}"
                           Foreground="White"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           MaxWidth="340"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="App Settings"
                              Margin="0,10,0,10"
                              Foreground="#3A86C8"
                              BorderBrush="#666"
                              Grid.Row="2"
                              BorderThickness="0.5" Grid.ColumnSpan="2">

                        <StackPanel Margin="10">
                            <TextBlock Text="Cardholder Group *"
                                       Margin="0,10,0,0"
                                       Foreground="White"/>
                            <ComboBox
    ItemsSource="{Binding AllCardholderGroups}"
    SelectedItem="{Binding SelectedCardholderGroup, Mode=TwoWay}"
    DisplayMemberPath="Name"
    IsEditable="True"
    IsTextSearchEnabled="True"
    IsTextSearchCaseSensitive="False"
    StaysOpenOnEdit="True"
    TextSearch.TextPath="Name"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>